<?xml version="1.0" encoding="utf-8"?>
<!-- پس‌زمینه Splash Screen - لوگوی دامداران در مرکز صفحه با گرادیان -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- پس‌زمینه تیره عمیق -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="@color/splash_gradient_start"
                android:endColor="@color/splash_gradient_end" />
        </shape>
    </item>

    <!-- لوگوی دامداران در مرکز - استفاده از bitmap با gravity center و اندازه intrinsically -->
    <item
        android:width="180dp"
        android:height="180dp"
        android:gravity="center"
        android:drawable="@drawable/splash_logo" />
</layer-list>
